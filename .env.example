# =============================================================================
# Web (Vercel) + Worker (Railway) — required by both
# =============================================================================

# Postgres connection. Web and worker must point at the same database.
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# Continuous backend indexer polling interval (milliseconds). Used by the
# worker to pace iterations and by the dashboard to compute collector
# "healthy / lagging / stale" thresholds.
INDEXER_POLL_INTERVAL_MS="30000"

# =============================================================================
# Web only — required only if you expose POST /api/indexers/run
# =============================================================================

# HMAC secret for the /api/indexers/run trigger endpoint. If unset, the route
# returns 503. Only set this if something external (cron, CI) needs to poke
# the indexer over HTTP.
INDEXER_CRON_SECRET="replace-with-random-secret"
# Optional comma-separated source-IP allowlist for /api/indexers/run.
INDEXER_ALLOWED_IPS=""

# =============================================================================
# Local-only — used by `pnpm indexers:trigger` from your machine
# =============================================================================

# Dashboard base URL used by the trigger helper script.
DASHBOARD_BASE_URL="http://localhost:3000"

# =============================================================================
# Worker (Railway) only — not used by the frontend
# =============================================================================
# The RPC pool, request timeout, backfill seed, progress log cadence, block/
# chunk concurrency, and max-blocks-per-run are hardcoded in
# src/lib/indexers/near-rpc-manager.ts and src/lib/indexers/near.ts. Only
# deployment-specific values below remain env-configurable.

# Comma-separated FastAuth contract IDs used for sign-event derivation.
FASTAUTH_CONTRACT_IDS="fast-auth.near,fast-auth.testnet"

# MPC contract ID. Defaults to v1.signer (mainnet) or v1.signer-prod.testnet
# (testnet) inferred from FastAuth contract IDs. Set this only if you've
# deployed FastAuth against a non-default MPC contract.
# FASTAUTH_MPC_CONTRACT_ID=""

# URL template(s) used to resolve accounts by user public key. Supports a
# {publicKey} token or a base URL that accepts ?publicKey=<key>. Multiple
# templates can be provided comma-separated; the linker round-robins across
# them with rate-limit-aware failover.
FASTAUTH_PUBLIC_KEY_ACCOUNTS_URL_TEMPLATES="https://api.fastnear.com/v1/public_key/{publicKey}/all"
# Legacy single-template variable (still honored; merged with _TEMPLATES).
# FASTAUTH_PUBLIC_KEY_ACCOUNTS_URL_TEMPLATE=""

# Secondary pubkey→account lookup (queried in parallel with FastNEAR; results
# unioned and deduped to catch multi-account edge cases and survive any
# single-source outage). Default: NearBlocks public kitwallet API.
# FASTAUTH_PUBLIC_KEY_ACCOUNTS_NEARBLOCKS_TEMPLATES="https://api.nearblocks.io/v1/kitwallet/publicKey/{publicKey}/accounts"
# Optional NearBlocks API key. Public reads work without one; set if rate-limited.
# NEARBLOCKS_API_KEY=""

# Optional FastNEAR API key. Sent as `Authorization: Bearer ...`. Required
# once you hit the anonymous rate limit on FastNEAR endpoints (live indexer
# and public-key linker both use it when set).
# FASTNEAR_API_KEY=""

# Max sign events processed per run by the public-key account linker.
FASTAUTH_PUBLIC_KEY_ACCOUNTS_BATCH_SIZE="200"
# Fallback lookback (days) when there is no public-key linker checkpoint yet.
FASTAUTH_PUBLIC_KEY_LOOKBACK_DAYS="30"
