generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth0Log {
  logId       String   @id @map("log_id")
  timestamp   DateTime
  type        String
  description String?
  clientId    String?  @map("client_id")
  clientName  String?  @map("client_name")
  connection  String?
  userIdHash  String?  @map("user_id_hash")
  payload     Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([type, timestamp])
  @@map("auth0_logs")
}

model ServiceMetricSample {
  id          BigInt   @id @default(autoincrement())
  timestamp   DateTime
  serviceName String   @map("service_name")
  metricName  String   @map("metric_name")
  labels      Json     @map("labels_json")
  value       Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([serviceName, metricName, timestamp])
  @@map("service_metrics_timeseries")
}

model NearTransaction {
  txHash               String   @id @map("tx_hash")
  blockHeight          BigInt?  @map("block_height")
  blockTimestamp       DateTime? @map("block_timestamp")
  signerAccountId      String?  @map("signer_account_id")
  signerPublicKey      String?  @map("signer_public_key")
  receiverId           String?  @map("receiver_id")
  methodName           String?  @map("method_name")
  executionStatus      String?  @map("execution_status")
  failureReason        String?  @map("failure_reason")
  gasBurnt             BigInt?  @map("gas_burnt")
  attachedDepositYocto String?  @map("attached_deposit_yocto")
  payload              Json     @map("payload_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([blockHeight])
  @@index([receiverId, blockHeight])
  @@map("near_transactions")
}

model FastAuthSignEvent {
  id                    BigInt   @id @default(autoincrement())
  txHash                String   @map("tx_hash")
  actionIndex           Int      @map("action_index")
  blockHeight           BigInt   @map("block_height")
  blockTimestamp        DateTime @map("block_timestamp")
  relayerAccountId      String   @map("relayer_account_id")
  relayerPublicKey      String?  @map("relayer_public_key")
  fastAuthContractId    String   @map("fastauth_contract_id")
  guardId               String?  @map("guard_id")
  guardName             String?  @map("guard_name")
  providerType          String   @map("provider_type")
  algorithm             String?  @map("algorithm")
  userSub               String?  @map("user_sub")
  userKeyPath           String?  @map("user_key_path")
  userDomainId          Int?     @map("user_domain_id")
  userDerivedPublicKey  String?  @map("user_derived_public_key")
  userAccountId         String?  @map("user_account_id")
  signActionType        String?  @map("sign_action_type")
  projectDappId         String?  @map("project_dapp_id")
  sponsoredAccountId    String?  @map("sponsored_account_id")
  sponsoredAccountHash  String?  @map("sponsored_account_hash")
  verifyPayloadHash     String?  @map("verify_payload_hash")
  signPayloadJson       Json?    @map("sign_payload_json")
  executionStatus       String?  @map("execution_status")
  failureReason         String?  @map("failure_reason")
  gasBurnt              BigInt?  @map("gas_burnt")
  attachedDepositYocto  String?  @map("attached_deposit_yocto")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([txHash, actionIndex])
  @@index([blockTimestamp])
  @@index([relayerAccountId, blockTimestamp])
  @@index([relayerPublicKey, blockTimestamp])
  @@index([userDerivedPublicKey, blockTimestamp])
  @@index([userAccountId, blockTimestamp])
  @@index([signActionType, blockTimestamp])
  @@index([projectDappId, blockTimestamp])
  @@index([providerType, blockTimestamp])
  @@map("fastauth_sign_events")
}

// Tracks NEAR transactions submitted by a FastAuth relayer that wrap a
// Delegate action signed with a FastAuth-derived key. These are the on-chain
// "consumers" of FastAuth signatures — i.e. the AddKey/Transfer/FunctionCall
// txs the relayer crafts after receiving a signature from FastAuth.sign().
// Their execution_status / failure_reason tell us whether the action actually
// landed on chain, independent of whether the original sign() call succeeded.
model FastAuthConsumerTransaction {
  id                   BigInt   @id @default(autoincrement())
  txHash               String   @unique @map("tx_hash")
  blockHeight          BigInt   @map("block_height")
  blockTimestamp       DateTime @map("block_timestamp")
  outerSignerId        String   @map("outer_signer_id")
  outerSignerPublicKey String?  @map("outer_signer_public_key")
  innerSignerId        String   @map("inner_signer_id")
  innerReceiverId      String   @map("inner_receiver_id")
  innerPublicKey       String   @map("inner_public_key")
  innerActionTypes     String[] @map("inner_action_types")
  executionStatus      String?  @map("execution_status")
  failureReason        String?  @map("failure_reason")
  linkedSignEventId    BigInt?  @map("linked_sign_event_id")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([blockTimestamp])
  @@index([innerPublicKey, blockTimestamp])
  @@index([innerSignerId, blockTimestamp])
  @@index([failureReason])
  @@index([executionStatus, blockTimestamp])
  @@map("fastauth_consumer_transactions")
}

// Real on-chain activity by FastAuth users. Captures any tx whose
// signer_account_id is registered in fastauth_public_key_accounts — i.e.
// accounts holding the FastAuth-derived MPC key (K_FA). Activity is
// anchored on the account, not on individual session keys: when a Sweat
// user logs out and a new K_session is installed, the same account
// continues signing, so usage attribution remains stable across
// session-key rotations.
model FastAuthUserTransaction {
  txHash            String   @id @map("tx_hash")
  blockHeight       BigInt   @map("block_height")
  blockTimestamp    DateTime @map("block_timestamp")
  signerAccountId   String   @map("signer_account_id")
  signerPublicKey   String?  @map("signer_public_key")
  receiverId        String   @map("receiver_id")
  methodName        String?  @map("method_name")
  actionTypes       String[] @map("action_types")
  // True if this row was extracted from a Delegate-wrapped meta-tx
  // (signer = relayer; sender_id of inner Delegate = a known FastAuth user).
  // False for direct user txs.
  metaWrapped       Boolean  @default(false) @map("meta_wrapped")
  // Total USD value moved by this tx, computed at index-time using prices
  // from 1click.chaindefuser.com. Null when none of the actions involve a
  // priced token (e.g. pure FunctionCalls with no token transfer).
  valueUsd          Decimal? @db.Decimal(20, 4) @map("value_usd")
  // Per-token breakdown — parallel arrays, all the same length per row.
  // Set up so a future "Top tokens" panel can UNNEST and GROUP BY symbol
  // for ranking. Empty arrays when valueUsd is null. Native NEAR shows
  // up here as symbol "NEAR" / decimals 24.
  tokenSymbols      String[]   @map("token_symbols")
  tokenAmounts      String[]   @map("token_amounts")     // raw u128 strings
  tokenDecimals     Int[]      @map("token_decimals")
  tokenValuesUsd    Decimal[]  @db.Decimal(20, 8) @map("token_values_usd")
  executionStatus   String?  @map("execution_status")
  failureReason     String?  @map("failure_reason")
  gasBurnt          BigInt?  @map("gas_burnt")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([blockTimestamp])
  @@index([signerAccountId, blockTimestamp])
  @@index([receiverId, blockTimestamp])
  @@index([methodName, blockTimestamp])
  @@index([executionStatus, blockTimestamp])
  @@index([valueUsd])
  @@map("fastauth_user_transactions")
}

model FastAuthPublicKeyAccount {
  id              BigInt   @id @default(autoincrement())
  publicKey       String   @map("public_key")
  accountId       String   @map("account_id")
  keyPath         String?  @map("key_path")
  predecessorId   String?  @map("predecessor_id")
  domainId        Int?     @map("domain_id")
  firstSeenAt     DateTime @map("first_seen_at")
  lastSeenAt      DateTime @map("last_seen_at")
  lastSourceEventId BigInt? @map("last_source_event_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([publicKey, accountId])
  @@index([accountId])
  @@index([keyPath])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@map("fastauth_public_key_accounts")
}

model Relayer {
  accountId                    String   @id @map("account_id")
  firstSeenAt                  DateTime @map("first_seen_at")
  lastSeenAt                   DateTime @map("last_seen_at")
  totalSignTransactions        Int      @default(0) @map("total_sign_transactions")
  totalGasBurnt                BigInt?  @map("total_gas_burnt")
  totalSponsoredUniqueAccounts Int      @default(0) @map("total_sponsored_unique_accounts")
  projectOwner                 String?  @map("project_owner")
  providerMixJson              Json?    @map("provider_mix_json")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@index([lastSeenAt])
  @@map("relayers")
}

model RelayerDapp {
  id                           BigInt   @id @default(autoincrement())
  relayerAccountId             String   @map("relayer_account_id")
  dappContractId               String   @map("dapp_contract_id")
  providerType                 String   @map("provider_type")
  firstSeenAt                  DateTime @map("first_seen_at")
  lastSeenAt                   DateTime @map("last_seen_at")
  totalSignTransactions        Int      @default(0) @map("total_sign_transactions")
  totalGasBurnt                BigInt?  @map("total_gas_burnt")
  totalSponsoredUniqueAccounts Int      @default(0) @map("total_sponsored_unique_accounts")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@unique([relayerAccountId, dappContractId, providerType])
  @@index([relayerAccountId, lastSeenAt])
  @@index([dappContractId, lastSeenAt])
  @@map("relayer_dapps")
}

model AccountTvlDailySnapshot {
  id                     BigInt   @id @default(autoincrement())
  accountId              String   @map("account_id")
  snapshotDate           DateTime @map("snapshot_date")
  totalUsd               Float?   @map("total_usd")
  nativeNearBalanceYocto String?  @map("native_near_balance_yocto")
  nativeNearLockedYocto  String?  @map("native_near_locked_yocto")
  assets                 Json     @map("assets_json")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("account_tvl_daily_snapshots")
}

model IndexerCheckpoint {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("indexer_checkpoints")
}

// Per-tx receipt-level classification of every FastAuth-touching tx, used by
// the MPC Status / Fast Auth Status cards and the Transactions panel's
// Failed/Pending counts. Sourced from near_transactions (no extra block walk
// required), populated by collectFastAuthHealth via the NEAR `tx` RPC. Rows
// are mutable: rpc_pending entries get retried until classified or until
// retry_count hits the cap, at which point they freeze as rpc_pending — we
// never lie about an unconfirmed outcome by promoting it to other_failure.
//
// outcome: success | guard_failure | mpc_failure | other_failure | rpc_pending
//   - success         : every receipt succeeded
//   - guard_failure   : failure happened in FastAuth contract, JwtGuardRouter,
//                       or a specific guard (Auth0Guard etc.) — i.e. before
//                       any receipt with the MPC contract as executor
//   - mpc_failure     : a receipt whose executor is the MPC contract failed
//   - other_failure   : reached MPC but failure was elsewhere (callback etc.)
//   - rpc_pending     : tx RPC has not yet returned a usable status
//
// failingExecutorId is set on any *_failure outcome to the account_id of the
// failing receipt's executor. Lets us slice "guard failures by guard" later
// (Auth0 vs Firebase vs Custom) without re-classifying.
model FastAuthHealthTx {
  txHash            String    @id @map("tx_hash")
  signerId          String    @map("signer_id")
  blockHeight       BigInt    @map("block_height")
  blockTimestamp    DateTime  @map("block_timestamp")
  // Nullable because for rpc_pending rows we genuinely don't know yet.
  // Once classified, true if any receipt's executor was the MPC contract.
  reachedMpc        Boolean?  @map("reached_mpc")
  outcome           String
  failingExecutorId String?   @map("failing_executor_id")
  // Receipt-level failure payload (e.g. "Smart contract panicked: Request
  // has timed out."). Set on any *_failure outcome, null otherwise.
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastAttemptedAt   DateTime? @map("last_attempted_at")
  lastError         String?   @map("last_error")
  classifiedAt      DateTime? @map("classified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([blockTimestamp, outcome])
  @@index([outcome, lastAttemptedAt])
  @@map("fastauth_health_tx")
}

// Per-tx receipt-level classification of consumer transactions (relayer-
// submitted Delegate-wrapped meta-txs that consume a FastAuth signature).
// Mirrors fastauth_health_tx in shape; outcome enum is simpler because these
// don't pass through the FA → MPC pipeline:
//   success | failure | rpc_pending
// failing_executor_id + failure_reason carry the "why" when outcome=failure.
model FastAuthConsumerHealthTx {
  txHash            String    @id @map("tx_hash")
  signerId          String    @map("signer_id")
  blockHeight       BigInt    @map("block_height")
  blockTimestamp    DateTime  @map("block_timestamp")
  outcome           String
  failingExecutorId String?   @map("failing_executor_id")
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastAttemptedAt   DateTime? @map("last_attempted_at")
  lastError         String?   @map("last_error")
  classifiedAt      DateTime? @map("classified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([blockTimestamp, outcome])
  @@index([outcome, lastAttemptedAt])
  @@map("fastauth_consumer_health_tx")
}

// Same structure for real user activity (signer holds a FastAuth-derived MPC
// key). Surfaces accurate Failed counts in the Real Activity panel.
model FastAuthUserHealthTx {
  txHash            String    @id @map("tx_hash")
  signerId          String    @map("signer_id")
  blockHeight       BigInt    @map("block_height")
  blockTimestamp    DateTime  @map("block_timestamp")
  outcome           String
  failingExecutorId String?   @map("failing_executor_id")
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastAttemptedAt   DateTime? @map("last_attempted_at")
  lastError         String?   @map("last_error")
  classifiedAt      DateTime? @map("classified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([blockTimestamp, outcome])
  @@index([outcome, lastAttemptedAt])
  @@map("fastauth_user_health_tx")
}

model FastAuthChainHealthSnapshot {
  id                     Int       @id @default(autoincrement())
  computedAt             DateTime  @default(now()) @map("computed_at")
  chainHead              BigInt    @map("chain_head")
  windowStartHeight      BigInt    @map("window_start_height")
  windowEndHeight        BigInt    @map("window_end_height")
  windowBlocks           Int       @map("window_blocks")
  totalTransactions      Int       @map("total_transactions")
  successfulTransactions Int       @map("successful_transactions")
  failedTransactions     Int       @map("failed_transactions")
  guardFailedTransactions   Int    @default(0) @map("guard_failed_transactions")
  mpcAttemptedTransactions  Int    @default(0) @map("mpc_attempted_transactions")
  mpcFailedTransactions     Int    @default(0) @map("mpc_failed_transactions")
  distinctRelayers       Int       @map("distinct_relayers")
  lastSuccessTimestamp   DateTime? @map("last_success_timestamp")
  lastSuccessTxHash      String?   @map("last_success_tx_hash")

  @@index([computedAt])
  @@map("fastauth_chain_health_snapshots")
}

model MissingBlockRange {
  id              BigInt   @id @default(autoincrement())
  startHeight     BigInt   @map("start_height")
  endHeight       BigInt   @map("end_height")
  reason          String
  status          String   @default("open")
  completedUpTo   BigInt?  @map("completed_up_to")
  completedDownTo BigInt?  @map("completed_down_to")
  recordedAt      DateTime @map("recorded_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([startHeight, endHeight])
  @@index([status])
  @@map("missing_block_ranges")
}

model Account {
  accountId          String   @id @map("account_id")
  accountType        String   @map("account_type")
  firstSeenAt        DateTime @map("first_seen_at")
  lastSeenAt         DateTime @map("last_seen_at")
  publicKeyCount     Int      @default(0) @map("public_key_count")
  firstSourceEventId BigInt?  @map("first_source_event_id")
  lastSourceEventId  BigInt?  @map("last_source_event_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([accountType])
  @@map("accounts")
}
